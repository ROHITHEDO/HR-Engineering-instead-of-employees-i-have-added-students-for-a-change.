{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=StudentManagementDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    //"Key": "THIS_IS_ONLY_FOR_LOCAL_DEVELOPMENT_CHANGE_THIS_LATER",
    "Issuer": "StudentManagement.API",
    "Audience": "StudentManagement.Client",
    "ExpirationMinutes": 60
  },
  "AzureStorage": {
    "ContainerName": "student-documents"
  },
  "ServiceBus": {
    "QueueName": "queue.1" //"student-created"
  },

  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text",
    "ChatModel": "llama3.2"
  },

  "Qdrant": {
    "Host": "localhost",
    "GrpcPort": 6334,
    "CollectionName": "student_documents"
  }


}
